# Required production values. These are public Supabase project identifiers,
# not privileged database credentials. Set them in the deployment environment.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Optional development-only Preview/debug controls. Never active in production.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false
